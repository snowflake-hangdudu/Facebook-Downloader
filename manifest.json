{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_extName__",
  "version": "1.0.0",
  "description": "__MSG_extDesc__",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://*.facebook.com/*",
    "https://facebook.com/*",
    "https://fb.watch/*",
    "https://*.fbcdn.net/*",
    "https://*.fbsbx.com/*",
    "http://124.222.62.190:8081/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://*.facebook.com/*",
        "https://facebook.com/*",
        "https://fb.watch/*"
      ],
      "js": [
        "content/ad-prefs.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://*.facebook.com/*",
        "https://facebook.com/*",
        "https://fb.watch/*"
      ],
      "js": [
        "content/facebook-model.js",
        "content/page-agent.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://*.facebook.com/*",
        "https://facebook.com/*",
        "https://fb.watch/*"
      ],
      "js": [
        "shared/runtime.js",
        "shared/dom.js",
        "shared/debug-flag.js",
        "shared/debug.js",
        "shared/remote-content.js",
        "shared/theme.js",
        "shared/settings.js",
        "shared/notice.js",
        "shared/rating.js",
        "shared/panel.js",
        "shared/shell.js",
        "shared/i18n.js",
        "content/facebook-model.js",
        "content/content.js"
      ],
      "css": [
        "shared/panel.css",
        "shared/design-system.css",
        "content/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "__MSG_extName__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon48.png",
        "icons/icon128.png",
        "shared/themes.json"
      ],
      "matches": [
        "https://www.facebook.com/*",
        "https://*.facebook.com/*",
        "https://facebook.com/*",
        "https://fb.watch/*"
      ]
    }
  ]
}
